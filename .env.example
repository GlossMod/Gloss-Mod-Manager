# Server-side GitHub token used to browse public Discussions, resolve category ids,
# and provide anonymous read fallback on the site.
NUXT_GITHUB_TOKEN=""

# GitHub OAuth App credentials used for site login.
NUXT_GITHUB_CLIENT_ID=""
NUXT_GITHUB_CLIENT_SECRET=""

# Secret used to encrypt the GitHub session cookie.
NUXT_SESSION_SECRET="replace-this-with-a-long-random-secret"

# Repository node id for GlossMod/Gloss-Mod-Manager.
NUXT_GITHUB_REPO_ID="R_kgDOJxuy0Q"

# GitHub Discussions category node id or slug for the "new-games" category.
NUXT_GITHUB_NEW_GAMES_CATEGORY_ID="new-games"

# Public site URL used for canonical links, sitemap and robots.txt.
NUXT_PUBLIC_SITE_URL="https://gmm.aoe.top"

# Legacy compatibility variables still read by nuxt.config.ts.
NUXT_PUBLIC_GISCUS_REPO_ID="R_kgDOJxuy0Q"
NUXT_PUBLIC_GISCUS_NEW_GAMES_CATEGORY_ID="new-games"

# Extra legacy fallback names still supported by nuxt.config.ts.
# GITHUB_TOKEN=""
# NUXT_GISCUS_NEW_GAMES_CATEGORY_ID=""
# VITE_SITE_URL="https://gmm.aoe.top"
# VITE_GISCUS_REPO_ID="R_kgDOJxuy0Q"
# VITE_GISCUS_NEW_GAMES_CATEGORY_ID=""